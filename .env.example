# Database (Turso). Leave unset to use a local SQLite file at data/ws.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Paystack card checkout. Get test keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Flutterwave card/bank/USSD checkout. Get keys from https://dashboard.flutterwave.com/
FLW_SECRET_KEY=
NEXT_PUBLIC_FLW_PUBLIC_KEY=
FLW_SECRET_HASH=

# Manual/bank-transfer fallback needs no keys; select "Bank transfer" at checkout.

# Public application URL, used for payment callbacks and order links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Explicit opt-in for no-key local/demo checkouts. Never enable with real payments.
WS_DEMO_PAYMENTS=false

# Optional: protects admin endpoints. Defaults to a random value if missing.
ADMIN_TOKEN=

# Accounts. SESSION_SECRET is recommended; if omitted the app stores a generated secret in app_settings.
SESSION_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=WS Storefront <your-gmail-address@gmail.com>
# Comma-separated emails that should have moderation access. The first account is bootstrapped as admin if unset.
ADMIN_EMAILS=
