# Database (Turso). Leave unset to use a local SQLite file at data/ws.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Paystack. Get test keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Public application URL, used for Paystack callback and order links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Explicit opt-in for no-key local/demo checkouts. Never enable with real payments.
WS_DEMO_PAYMENTS=false

# Optional: protects admin endpoints. Defaults to a random value if missing.
ADMIN_TOKEN=
